datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LeaveKind {
  YEARLY
  PER_EVENT
}

enum CountingMode {
  WORKING_DAYS
  CALENDAR_DAYS
}

enum LedgerEntryType {
  GRANT
  ADJUST
  DEDUCT
}

enum LeaveStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStep {
  MANAGER
  HR
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum HolidayType {
  REGULAR
  SPECIAL
}

enum DocumentTypeCode {
  COE
  COE_COMPENSATION
  LEAVE_CERT
  PAYSLIP
}

enum DocumentRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum IssuedDocumentStatus {
  VALID
  REVOKED
}

enum PayrollPeriodType {
  FIRST_HALF
  SECOND_HALF
  MONTHLY
}

enum PayrollRunStatus {
  DRAFT
  COMPUTED
  APPROVED
  LOCKED
  PAID
}

enum AdjustmentType {
  OVERTIME_HOURS
  BONUS
  ALLOWANCE
  DEDUCTION
}

enum LineCategory {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

model Tenant {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  users              User[]
  employees          Employee[]
  departments        Department[]
  leaveTypes         LeaveType[]
  leaveLedger        LeaveLedgerEntry[]
  leaveRequests      LeaveRequest[]
  leaveApprovals     LeaveApproval[]
  holidays           Holiday[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  documentTypes      DocumentType[]
  documentRequests   DocumentRequest[]
  issuedDocuments    IssuedDocument[]
  payrollPeriods     PayrollPeriod[]
  payrollRuns        PayrollRun[]
  payrollAdjustments PayrollAdjustment[]
  payrollItems       PayrollItem[]
  payrollItemLines   PayrollItemLine[]
  attendanceRecords  AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String   @db.Uuid
  email        String   @unique
  passwordHash String
  roles        Role[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee?
  notifications Notification[]
  auditLogs     AuditLog[]
  createdGrants LeaveLedgerEntry[] @relation("CreatedBy")

  @@index([tenantId, email])
}

model Employee {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String         @db.Uuid
  userId        String         @unique @db.Uuid
  employeeNo    String
  firstName     String
  lastName      String
  departmentId  String?        @db.Uuid
  position      String
  managerId     String?        @db.Uuid
  hireDate      DateTime       @db.Date
  gender        Gender
  maritalStatus MaritalStatus
  phone         String?
  address       String?
  avatarUrl     String?
  avatarKey     String?
  status        EmployeeStatus @default(ACTIVE)
  basicSalary   Decimal        @default(30000.00) @db.Decimal(12, 2)
  allowances    Decimal        @default(2000.00) @db.Decimal(12, 2)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  manager            Employee?           @relation("Reports", fields: [managerId], references: [id])
  subordinates       Employee[]          @relation("Reports")
  leaveLedger        LeaveLedgerEntry[]
  requests           LeaveRequest[]
  approvals          LeaveApproval[]
  requestedDocs      DocumentRequest[]   @relation("RequestedDocs")
  reviewedDocs       DocumentRequest[]   @relation("ReviewedDocs")
  issuedDocs         IssuedDocument[]
  payrollItems       PayrollItem[]
  payrollAdjustments PayrollAdjustment[]
  preparedRuns          PayrollRun[]                  @relation("PreparedBy")
  approvedRuns          PayrollRun[]                  @relation("ApprovedBy")
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
  decidedCorrections    AttendanceCorrectionRequest[]       @relation("CorrectionDecidedBy")

  @@unique([tenantId, employeeNo])
  @@index([tenantId, managerId])
}

model Department {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
}

model LeaveType {
  id                    String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String         @db.Uuid
  code                  String
  name                  String
  kind                  LeaveKind
  defaultDays           Int
  countingMode          CountingMode
  eligibleGender        Gender?
  eligibleMaritalStatus MaritalStatus?
  minServiceMonths      Int            @default(0)
  requiresAttachment    Boolean        @default(false)
  active                Boolean        @default(true)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries LeaveLedgerEntry[]
  requests      LeaveRequest[]

  @@unique([tenantId, code])
}

model LeaveLedgerEntry {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String          @db.Uuid
  employeeId  String          @db.Uuid
  leaveTypeId String          @db.Uuid
  year        Int
  type        LedgerEntryType
  days        Int
  reason      String?
  requestId   String?         @unique @db.Uuid
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  request   LeaveRequest? @relation(fields: [requestId], references: [id])
  createdBy User          @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String      @db.Uuid
  employeeId  String      @db.Uuid
  leaveTypeId String      @db.Uuid
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  days           Int
  reason         String
  attachmentKey  String?
  attachmentName String?
  status         LeaveStatus @default(PENDING_MANAGER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvals   LeaveApproval[]
  ledgerEntry LeaveLedgerEntry?

  @@index([tenantId, employeeId, status])
}

model LeaveApproval {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String           @db.Uuid
  requestId  String           @db.Uuid
  step       ApprovalStep
  approverId String           @db.Uuid
  decision   ApprovalDecision
  comment    String?
  decidedAt  DateTime         @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request  LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver Employee     @relation(fields: [approverId], references: [id])

  @@index([tenantId, requestId])
}

model Holiday {
  id       String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String      @db.Uuid
  date     DateTime    @db.Date
  name     String
  type     HolidayType

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model Notification {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String    @db.Uuid
  recipientId String    @db.Uuid
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, readAt])
}

model AuditLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @db.Uuid
  actorId   String   @db.Uuid
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
}

model DocumentType {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String           @db.Uuid
  code             DocumentTypeCode
  name             String
  description      String
  requiresApproval Boolean          @default(true)
  includesSalary   Boolean          @default(false)
  slaDays          Int              @default(3) // DOLE 3-day SLA
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests DocumentRequest[]

  @@unique([tenantId, code])
}

model DocumentRequest {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                @db.Uuid
  employeeId     String                @db.Uuid
  documentTypeId String                @db.Uuid
  purpose        String
  payPeriod      String? // Optional: For PAYSLIP document requests (e.g. "October 16-31, 2026")
  status         DocumentRequestStatus @default(PENDING_APPROVAL)
  requestedAt    DateTime              @default(now())
  dueAt          DateTime // DOLE 3 working days target
  reviewedById   String?               @db.Uuid
  reviewedAt     DateTime?
  rejectReason   String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee        @relation("RequestedDocs", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     Employee?       @relation("ReviewedDocs", fields: [reviewedById], references: [id])
  documentType   DocumentType    @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  issuedDocument IssuedDocument?

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model IssuedDocument {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String               @db.Uuid
  requestId        String               @unique @db.Uuid
  documentNo       String // e.g. "AZIR-DOC-2026-0001"
  verificationCode String               @unique // Secure random token for QR code
  snapshotData     Json // Immutable frozen snapshot of employee details, salary, & leave details
  issuedAt         DateTime             @default(now())
  issuedById       String               @db.Uuid
  status           IssuedDocumentStatus @default(VALID)
  revokedAt        DateTime?
  revokedReason    String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request  DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  issuedBy Employee        @relation(fields: [issuedById], references: [id])

  @@unique([tenantId, documentNo])
  @@index([tenantId, verificationCode])
}

model PayrollPeriod {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String            @db.Uuid
  name        String
  cutoffType  PayrollPeriodType @default(FIRST_HALF)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  payDate     DateTime          @db.Date
  workingDays Int               @default(11)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRuns PayrollRun[]

  @@unique([tenantId, startDate, endDate])
  @@index([tenantId, startDate])
}

model PayrollRun {
  id                         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                   String           @db.Uuid
  payrollPeriodId            String           @db.Uuid
  runNumber                  String
  status                     PayrollRunStatus @default(DRAFT)
  totalGross                 Decimal          @default(0.00) @db.Decimal(14, 2)
  totalDeductions            Decimal          @default(0.00) @db.Decimal(14, 2)
  totalNet                   Decimal          @default(0.00) @db.Decimal(14, 2)
  totalEmployeeContributions Decimal          @default(0.00) @db.Decimal(14, 2)
  totalEmployerContributions Decimal          @default(0.00) @db.Decimal(14, 2)
  preparedById               String           @db.Uuid
  approvedById               String?          @db.Uuid
  approvedAt                 DateTime?
  lockedAt                   DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  preparedBy    Employee            @relation("PreparedBy", fields: [preparedById], references: [id])
  approvedBy    Employee?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  items         PayrollItem[]
  adjustments   PayrollAdjustment[]

  @@unique([tenantId, runNumber])
  @@index([tenantId, status])
}

model PayrollItem {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String  @db.Uuid
  payrollRunId      String  @db.Uuid
  employeeId        String  @db.Uuid
  basicPay          Decimal @db.Decimal(12, 2)
  allowances        Decimal @default(0.00) @db.Decimal(12, 2)
  overtimePay       Decimal @default(0.00) @db.Decimal(12, 2)
  absencesDeduction Decimal @default(0.00) @db.Decimal(12, 2)
  grossPay          Decimal @db.Decimal(12, 2)
  sssEe             Decimal @default(0.00) @db.Decimal(10, 2)
  sssEr             Decimal @default(0.00) @db.Decimal(10, 2)
  philHealthEe      Decimal @default(0.00) @db.Decimal(10, 2)
  philHealthEr      Decimal @default(0.00) @db.Decimal(10, 2)
  pagIbigEe         Decimal @default(0.00) @db.Decimal(10, 2)
  pagIbigEr         Decimal @default(0.00) @db.Decimal(10, 2)
  withholdingTax    Decimal @default(0.00) @db.Decimal(10, 2)
  otherDeductions   Decimal @default(0.00) @db.Decimal(10, 2)
  netPay            Decimal @db.Decimal(12, 2)
  issuedDocumentId  String? @db.Uuid

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines      PayrollItemLine[]

  @@unique([payrollRunId, employeeId])
  @@index([tenantId, employeeId])
}

model PayrollItemLine {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String       @db.Uuid
  payrollItemId String       @db.Uuid
  category      LineCategory
  code          String
  description   String
  amount        Decimal      @db.Decimal(10, 2)
  rate          Decimal?     @db.Decimal(10, 2)
  quantity      Decimal?     @db.Decimal(8, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollItemId])
}

model PayrollAdjustment {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String         @db.Uuid
  payrollRunId String         @db.Uuid
  employeeId   String         @db.Uuid
  type         AdjustmentType
  description  String
  amount       Decimal        @db.Decimal(10, 2)
  quantity     Decimal?       @db.Decimal(8, 2)
  createdAt    DateTime       @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, employeeId])
}

enum WorkLocationType {
  OFFICE
  FIELD_CLIENT_SITE
  REMOTE_WFH
}

enum AttendanceSource {
  WEB_PUNCH
  BIOMETRIC_IMPORT
  CORRECTION_OB
}

enum AttendanceStatus {
  PRESENT
  LATE
  UNDERTIME
  ABSENT
  ON_LEAVE
  OFFICIAL_BUSINESS
  REST_DAY
  HOLIDAY
}

enum CorrectionType {
  MISSED_PUNCH
  OFFICIAL_BUSINESS
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRecord {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String           @db.Uuid
  employeeId       String           @db.Uuid
  date             DateTime         @db.Date
  timeIn           DateTime?
  timeOut          DateTime?
  locationType     WorkLocationType @default(OFFICE)
  source           AttendanceSource @default(WEB_PUNCH)
  status           AttendanceStatus @default(PRESENT)
  lateMinutes      Int              @default(0)
  undertimeMinutes Int              @default(0)
  overtimeHours    Decimal          @default(0.00) @db.Decimal(5, 2)
  notes            String?          @db.VarChar(255)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
}

model AttendanceCorrectionRequest {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String           @db.Uuid
  employeeId      String           @db.Uuid
  date            DateTime         @db.Date
  type            CorrectionType   @default(MISSED_PUNCH)
  proposedTimeIn  DateTime?
  proposedTimeOut DateTime?
  locationType    WorkLocationType @default(FIELD_CLIENT_SITE)
  destination     String?          @db.VarChar(255)
  reason          String           @db.VarChar(500)
  status          CorrectionStatus @default(PENDING)
  decidedById     String?          @db.Uuid
  decidedAt       DateTime?
  decisionNote    String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  decidedBy Employee? @relation("CorrectionDecidedBy", fields: [decidedById], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}
